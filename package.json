{
  "name": "daisy",
  "version": "1.1.0",
  "description": "Simple photo sharing for events",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"wrangler dev\" \"npm --prefix src/web run dev\"",
    "dev:api": "wrangler dev",
    "dev:web": "npm --prefix src/web run dev",
    "build": "npm --prefix src/web run build",
    "lint": "npm --prefix src/web run lint",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy -c wrangler.prod.toml",
    "db:migrate": "wrangler d1 migrations apply daisy --local",
    "db:migrate:remote": "wrangler d1 migrations apply daisy --remote",
    "db:migrate:prod": "wrangler d1 migrations apply daisy --remote -c wrangler.prod.toml",
    "db:exec:prod": "wrangler d1 execute daisy --remote -c wrangler.prod.toml",
    "tail:prod": "wrangler tail -c wrangler.prod.toml",
    "test": "vitest run",
    "test:web": "npm --prefix src/web run test",
    "test:all": "vitest run && npm --prefix src/web run test",
    "load-test": "tsx scripts/load-test.ts",
    "postinstall": "cd src/web && npm install"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}
